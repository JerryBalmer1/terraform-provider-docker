{
  "_comment": "Hand-maintained map from docker / docker compose / docker swarm CLI commands to the provider type and attributes that do the same job. tools/genskill renders .claude/skills/docker-cli-map/SKILL.md from it plus tools/parity/paritydata, and fails (also under -check) when a type or attribute named here does not exist in the provider schema. Each command has either `map` (kind: resource | data | action | ephemeral | list | function | provider | tool; attrs are dotted paths into the schema, for a function its parameter names, for a tool a path in the repo) or `none` (why there is no equivalent; start it with BLOCKED: when the Engine API or framework cannot do it). Keep groups in order: docker, compose, swarm.",
  "commands": [
    {"cli": "docker run", "group": "docker", "map": [{"kind": "resource", "type": "docker_container", "attrs": ["image", "name", "command", "env", "ports", "mounts", "restart", "must_run"]}], "note": "One-off `docker run --rm` jobs: a docker_container with `must_run = false`, or a docker_exec action in an existing container."},
    {"cli": "docker create", "group": "docker", "map": [{"kind": "resource", "type": "docker_container", "attrs": ["must_run"]}], "note": "`must_run = false` creates without keeping it running."},
    {"cli": "docker start / docker stop", "group": "docker", "map": [{"kind": "resource", "type": "docker_container", "attrs": ["must_run"]}]},
    {"cli": "docker restart", "group": "docker", "none": "No in-place restart. Replace the container (`terraform apply -replace=docker_container.x`); for Swarm services use the docker_service_force_update action."},
    {"cli": "docker rm", "group": "docker", "map": [{"kind": "resource", "type": "docker_container", "attrs": []}], "note": "Remove the resource from configuration, or `terraform destroy -target=docker_container.x`."},
    {"cli": "docker exec", "group": "docker", "map": [{"kind": "action", "type": "docker_exec", "attrs": ["container", "service", "command", "env", "user", "workdir"]}, {"kind": "ephemeral", "type": "docker_exec_output", "attrs": ["container", "command"]}], "note": "Use the ephemeral resource when the command's stdout feeds other configuration."},
    {"cli": "docker cp (host to container)", "group": "docker", "map": [{"kind": "resource", "type": "docker_container", "attrs": ["upload", "upload.file", "upload.content", "upload.source"]}]},
    {"cli": "docker cp (container to host)", "group": "docker", "map": [{"kind": "action", "type": "docker_container_export", "attrs": ["container", "path"]}], "note": "Exports the whole filesystem as a tar; there is no single-file copy out."},
    {"cli": "docker logs", "group": "docker", "map": [{"kind": "data", "type": "docker_logs", "attrs": ["container", "tail", "since", "timestamps"]}]},
    {"cli": "docker ps", "group": "docker", "map": [{"kind": "data", "type": "docker_containers", "attrs": []}, {"kind": "list", "type": "docker_container", "attrs": []}]},
    {"cli": "docker export", "group": "docker", "map": [{"kind": "action", "type": "docker_container_export", "attrs": ["container", "path"]}]},
    {"cli": "docker commit", "group": "docker", "none": "No equivalent by design: snapshotting a container is not declarative. Build the image with docker_image from a Dockerfile."},
    {"cli": "docker update", "group": "docker", "map": [{"kind": "resource", "type": "docker_container", "attrs": ["memory", "cpu_shares", "restart"]}], "note": "Changes to resource limits are applied by the resource; some force replacement (see the reference)."},
    {"cli": "docker rename", "group": "docker", "map": [{"kind": "resource", "type": "docker_container", "attrs": ["name"]}]},
    {"cli": "docker pause / unpause / kill / wait / attach", "group": "docker", "none": "No equivalent: transient process control is not managed state. Use docker_exec for one-off commands."},
    {"cli": "docker stats / top / events / system df", "group": "docker", "none": "No equivalent: live streams and usage reports are not Terraform state."},
    {"cli": "docker pull", "group": "docker", "map": [{"kind": "resource", "type": "docker_image", "attrs": ["name", "keep_locally"]}]},
    {"cli": "docker build", "group": "docker", "map": [{"kind": "resource", "type": "docker_image", "attrs": ["name", "build", "build.context", "build.dockerfile", "build.builder"]}], "note": "`build.builder = \"buildkit\"` for BuildKit features (secrets, cache_from, platforms)."},
    {"cli": "docker buildx build", "group": "docker", "map": [{"kind": "resource", "type": "docker_image", "attrs": ["build.builder", "build.platforms", "build.secrets"]}], "note": "Builds on the daemon's own BuildKit; building on a docker_buildx_builder is an open TODO."},
    {"cli": "docker buildx create", "group": "docker", "map": [{"kind": "resource", "type": "docker_buildx_builder", "attrs": ["name", "driver"]}], "note": "docker-container driver only; the buildx instance list is BLOCKED (buildx-private local state)."},
    {"cli": "docker tag", "group": "docker", "map": [{"kind": "resource", "type": "docker_tag", "attrs": ["source_image", "target_image"]}]},
    {"cli": "docker push", "group": "docker", "map": [{"kind": "resource", "type": "docker_registry_image", "attrs": ["name", "keep_remotely"]}]},
    {"cli": "docker rmi", "group": "docker", "map": [{"kind": "resource", "type": "docker_image", "attrs": ["keep_locally"]}], "note": "Destroying a docker_image removes it unless `keep_locally = true`."},
    {"cli": "docker images / docker image inspect", "group": "docker", "map": [{"kind": "data", "type": "docker_image", "attrs": ["name"]}, {"kind": "list", "type": "docker_image", "attrs": []}]},
    {"cli": "docker save", "group": "docker", "map": [{"kind": "action", "type": "docker_image_save", "attrs": ["images", "path"]}]},
    {"cli": "docker load", "group": "docker", "map": [{"kind": "action", "type": "docker_image_load", "attrs": ["path"]}]},
    {"cli": "docker import", "group": "docker", "map": [{"kind": "action", "type": "docker_image_import", "attrs": ["source", "repository", "tag"]}]},
    {"cli": "docker image prune", "group": "docker", "map": [{"kind": "action", "type": "docker_image_prune", "attrs": ["dangling", "filters"]}]},
    {"cli": "docker system prune", "group": "docker", "map": [{"kind": "action", "type": "docker_system_prune", "attrs": ["containers", "images", "volumes", "networks", "build_cache"]}]},
    {"cli": "docker network create", "group": "docker", "map": [{"kind": "resource", "type": "docker_network", "attrs": ["name", "driver"]}]},
    {"cli": "docker network ls / inspect", "group": "docker", "map": [{"kind": "data", "type": "docker_network", "attrs": ["name"]}, {"kind": "list", "type": "docker_network", "attrs": []}]},
    {"cli": "docker volume create", "group": "docker", "map": [{"kind": "resource", "type": "docker_volume", "attrs": ["name", "driver"]}]},
    {"cli": "docker volume ls / inspect", "group": "docker", "map": [{"kind": "data", "type": "docker_volume", "attrs": ["name"]}, {"kind": "list", "type": "docker_volume", "attrs": []}]},
    {"cli": "docker login", "group": "docker", "map": [{"kind": "provider", "type": "docker", "attrs": ["registry_auth", "registry_auth.address", "registry_auth.username", "registry_auth.password", "allow_credential_helpers"]}, {"kind": "ephemeral", "type": "docker_registry_token", "attrs": []}]},
    {"cli": "docker context use / docker -H", "group": "docker", "map": [{"kind": "provider", "type": "docker", "attrs": ["context", "host", "ssh", "cert_path"]}]},
    {"cli": "docker plugin install", "group": "docker", "map": [{"kind": "resource", "type": "docker_plugin", "attrs": ["name", "enabled", "grant_all_permissions"]}, {"kind": "data", "type": "docker_plugin", "attrs": []}]},
    {"cli": "docker manifest inspect", "group": "docker", "map": [{"kind": "data", "type": "docker_registry_image_manifests", "attrs": ["name"]}, {"kind": "data", "type": "docker_registry_image", "attrs": ["name"]}]},
    {"cli": "registry tag listing (crane ls / skopeo list-tags)", "group": "docker", "map": [{"kind": "data", "type": "docker_registry_image_tags", "attrs": ["name"]}]},
    {"cli": "image reference parsing", "group": "docker", "map": [{"kind": "function", "type": "parse_image_ref", "attrs": ["ref"]}, {"kind": "function", "type": "image_ref", "attrs": []}]},
    {"cli": "docker port / -p parsing", "group": "docker", "map": [{"kind": "function", "type": "port_spec", "attrs": []}]},

    {"cli": "docker compose up", "group": "compose", "map": [{"kind": "resource", "type": "docker_compose", "attrs": ["content", "files", "project_name", "profiles", "env", "mode"]}], "note": "Or convert once to plain resources with tools/compose2stack."},
    {"cli": "docker compose down", "group": "compose", "map": [{"kind": "resource", "type": "docker_compose", "attrs": ["keep_volumes"]}], "note": "Destroy the docker_compose resource."},
    {"cli": "docker compose config / convert", "group": "compose", "map": [{"kind": "tool", "type": "tools/compose2stack", "attrs": []}], "note": "`go run ./tools/compose2stack -in docker-compose.yml -out stack.tf -mode swarm|local`."},
    {"cli": "docker compose ps", "group": "compose", "map": [{"kind": "resource", "type": "docker_compose", "attrs": ["services"]}]},
    {"cli": "docker compose exec", "group": "compose", "map": [{"kind": "action", "type": "docker_exec", "attrs": ["container"]}], "note": "Local-mode container names are `<project>-<service>-<n>`."},
    {"cli": "docker compose logs", "group": "compose", "map": [{"kind": "data", "type": "docker_logs", "attrs": ["container"]}]},
    {"cli": "docker compose pull", "group": "compose", "map": [{"kind": "resource", "type": "docker_image", "attrs": ["name"]}]},
    {"cli": "docker compose up --scale", "group": "compose", "map": [{"kind": "resource", "type": "docker_compose", "attrs": ["content"]}], "note": "Set `deploy.replicas` in the compose content."},
    {"cli": "docker compose build", "group": "compose", "none": "No equivalent inside docker_compose (compose `build:` is not implemented). Build with docker_image and reference its name."},
    {"cli": "docker compose run / watch / alpha", "group": "compose", "none": "No equivalent: one-off containers and file watching are not declarative. Use docker_exec for one-off commands."},

    {"cli": "docker swarm init", "group": "swarm", "map": [{"kind": "resource", "type": "docker_swarm_init", "attrs": ["advertise_addr", "autolock"]}]},
    {"cli": "docker swarm join", "group": "swarm", "map": [{"kind": "resource", "type": "docker_swarm_node", "attrs": ["host", "join_token", "role", "ssh"]}]},
    {"cli": "docker swarm join-token", "group": "swarm", "map": [{"kind": "data", "type": "docker_swarm_tokens", "attrs": []}, {"kind": "ephemeral", "type": "docker_swarm_tokens", "attrs": []}]},
    {"cli": "docker swarm join-token --rotate", "group": "swarm", "map": [{"kind": "action", "type": "docker_swarm_rotate_tokens", "attrs": ["worker", "manager"]}]},
    {"cli": "docker swarm unlock-key / update --autolock", "group": "swarm", "map": [{"kind": "resource", "type": "docker_swarm_init", "attrs": ["autolock", "unlock_key"]}]},
    {"cli": "docker swarm leave", "group": "swarm", "map": [{"kind": "resource", "type": "docker_swarm_node", "attrs": []}], "note": "Destroying docker_swarm_node leaves and removes the node."},
    {"cli": "docker swarm unlock", "group": "swarm", "none": "No equivalent: unlocking a restarted manager is an operator step; the key is docker_swarm_init.unlock_key."},
    {"cli": "docker node ls / inspect", "group": "swarm", "map": [{"kind": "data", "type": "docker_nodes", "attrs": []}, {"kind": "data", "type": "docker_node", "attrs": []}, {"kind": "list", "type": "docker_swarm_node", "attrs": []}]},
    {"cli": "docker node update --availability drain", "group": "swarm", "map": [{"kind": "action", "type": "docker_node_drain", "attrs": ["node"]}, {"kind": "resource", "type": "docker_swarm_node", "attrs": ["availability"]}], "note": "The action is for a one-off drain (it waits for tasks to leave); the attribute for the desired state."},
    {"cli": "docker node update --availability active", "group": "swarm", "map": [{"kind": "action", "type": "docker_node_activate", "attrs": ["node"]}, {"kind": "resource", "type": "docker_swarm_node", "attrs": ["availability"]}]},
    {"cli": "docker node promote / demote / update --label-add", "group": "swarm", "map": [{"kind": "resource", "type": "docker_swarm_node", "attrs": ["role", "labels"]}]},
    {"cli": "docker node rm", "group": "swarm", "map": [{"kind": "resource", "type": "docker_swarm_node", "attrs": []}]},
    {"cli": "docker service create / update", "group": "swarm", "map": [{"kind": "resource", "type": "docker_service", "attrs": ["name", "image", "replicas", "env", "networks"]}]},
    {"cli": "docker service scale", "group": "swarm", "map": [{"kind": "action", "type": "docker_service_scale", "attrs": ["service", "replicas"]}, {"kind": "resource", "type": "docker_service", "attrs": ["replicas"]}], "note": "The action does not change configuration; the next apply restores `replicas`."},
    {"cli": "docker service update --force", "group": "swarm", "map": [{"kind": "action", "type": "docker_service_force_update", "attrs": ["service"]}]},
    {"cli": "docker service rollback", "group": "swarm", "map": [{"kind": "action", "type": "docker_service_rollback", "attrs": ["service"]}]},
    {"cli": "docker service ls / inspect", "group": "swarm", "map": [{"kind": "data", "type": "docker_services", "attrs": []}, {"kind": "list", "type": "docker_service", "attrs": []}]},
    {"cli": "docker service ps / logs", "group": "swarm", "none": "No equivalent for tasks or aggregated service logs. Use docker_logs on a task container, or docker_exec with `service`."},
    {"cli": "docker service rm", "group": "swarm", "map": [{"kind": "resource", "type": "docker_service", "attrs": []}]},
    {"cli": "docker stack deploy", "group": "swarm", "map": [{"kind": "resource", "type": "docker_stack", "attrs": ["name", "service"]}, {"kind": "resource", "type": "docker_compose", "attrs": ["mode"]}], "note": "docker_compose with `mode = \"swarm\"` takes the compose file directly."},
    {"cli": "docker stack rm", "group": "swarm", "map": [{"kind": "resource", "type": "docker_stack", "attrs": []}]},
    {"cli": "docker stack ls / ps / services", "group": "swarm", "none": "No stack listing; use data docker_services filtered by the com.docker.stack.namespace label."},
    {"cli": "docker secret create", "group": "swarm", "map": [{"kind": "resource", "type": "docker_secret", "attrs": ["name", "data", "data_wo", "data_wo_version"]}]},
    {"cli": "docker secret ls", "group": "swarm", "map": [{"kind": "data", "type": "docker_secrets", "attrs": []}, {"kind": "list", "type": "docker_secret", "attrs": []}]},
    {"cli": "docker config create", "group": "swarm", "map": [{"kind": "resource", "type": "docker_config", "attrs": ["name", "data", "data_wo"]}]},
    {"cli": "docker config ls", "group": "swarm", "map": [{"kind": "data", "type": "docker_configs", "attrs": []}, {"kind": "list", "type": "docker_config", "attrs": []}]}
  ]
}
