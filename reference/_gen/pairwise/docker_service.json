{
  "type": "docker_service",
  "about": "Pairwise model for docker_service (Pass 6b Lane W), run in the harness -SwarmInit pass. Each attribute is checked against GET /services/{id} (the service spec) through the contract's inspect field map. null = attribute not set.",
  "seed": 1,
  "inspect": {"item": "swarm:service", "endpoint": "/services/{id}", "id_attr": "id"},
  "fixed": {
    "name": {"$hcl": "local.prefix"},
    "image": {"$hcl": "\"${var.pw_registry}busybox:1.36\""},
    "command": ["sleep", "3600"]
  },
  "attributes": {
    "mode": {
      "inspect": "spec.mode",
      "match": "subset",
      "values": [
        null,
        {"$set": "replicated", "$expect": {"Replicated": {}}},
        {"$set": "global", "$expect": {"Global": {}}}
      ]
    },
    "replicas": {
      "inspect": "spec.mode.replicated.replicas",
      "values": [null, 1, 2]
    },
    "env": {
      "inspect": "spec.task_template.container_spec.env",
      "match": "subset",
      "values": [
        null,
        {"$set": {"PW_A": "1", "PW_B": "two words"}, "$expect": ["PW_A=1", "PW_B=two words"], "$label": "two"}
      ]
    },
    "labels": {
      "inspect": "spec.labels",
      "match": "subset",
      "values": [
        null,
        {"$set": {"pw.a": "1"}, "$label": "one"},
        {"$set": {"pw.a": "1", "pw.b": "x y"}, "$label": "two"}
      ]
    },
    "container_labels": {
      "inspect": "spec.task_template.container_spec.labels",
      "match": "subset",
      "values": [null, {"$set": {"pw.c": "1"}, "$label": "one"}]
    },
    "resources.limits.memory_bytes": {
      "inspect": "spec.task_template.resources.limits.memory_bytes",
      "values": [null, 67108864, 134217728]
    },
    "resources.reservations.nano_cpus": {
      "inspect": "spec.task_template.resources.reservations.nano_cpus",
      "values": [null, 100000000]
    },
    "restart_policy": {
      "inspect": "spec.task_template.restart_policy",
      "match": "subset",
      "values": [
        null,
        {"$set": {"condition": "on-failure", "max_attempts": 3}, "$expect": {"Condition": "on-failure", "MaxAttempts": 3}, "$label": "on-failure-3"},
        {"$set": {"condition": "any", "delay": "5s"}, "$expect": {"Condition": "any", "Delay": 5000000000}, "$label": "any-5s"}
      ]
    },
    "update_config": {
      "inspect": "spec.update_config",
      "match": "subset",
      "values": [
        null,
        {"$set": {"parallelism": 2, "order": "start-first"}, "$expect": {"Parallelism": 2, "Order": "start-first"}, "$label": "par2-start-first"},
        {"$set": {"delay": "10s", "failure_action": "rollback", "monitor": "5s"}, "$expect": {"Delay": 10000000000, "FailureAction": "rollback", "Monitor": 5000000000}, "$label": "delay-rollback-monitor"}
      ]
    },
    "healthcheck": {
      "inspect": "spec.task_template.container_spec.healthcheck",
      "match": "subset",
      "values": [
        null,
        {"$set": {"test": ["CMD", "true"], "interval": "10s", "retries": 3}, "$expect": {"Test": ["CMD", "true"], "Interval": 10000000000, "Retries": 3}, "$label": "cmd-10s-3"}
      ]
    },
    "endpoint_spec": {
      "inspect": "spec.endpoint_spec",
      "match": "subset",
      "values": [
        null,
        {"$set": {"ports": [{"target_port": 80, "published_port": 18081}]}, "$expect": {"Ports": [{"TargetPort": 80, "PublishedPort": 18081}]}, "$label": "ingress-18081"},
        {"$set": {"mode": "dnsrr"}, "$expect": {"Mode": "dnsrr"}, "$label": "dnsrr"}
      ]
    },
    "mounts": {
      "inspect": "spec.task_template.container_spec.mounts",
      "match": "subset",
      "values": [
        null,
        {"$set": [{"type": "tmpfs", "target": "/scratch", "tmpfs_options": {"size_bytes": 1048576}}], "$expect": [{"Type": "tmpfs", "Target": "/scratch", "TmpfsOptions": {"SizeBytes": 1048576}}], "$label": "tmpfs"},
        {"$set": [{"type": "bind", "source": "/tmp", "target": "/hosttmp", "read_only": true}], "$expect": [{"Type": "bind", "Source": "/tmp", "Target": "/hosttmp", "ReadOnly": true}], "$label": "bind-ro"}
      ]
    },
    "read_only": {
      "inspect": "spec.task_template.container_spec.read_only",
      "values": [null, true]
    },
    "stop_grace_period": {
      "inspect": "spec.task_template.container_spec.stop_grace_period",
      "values": [
        null,
        {"$set": "5s", "$expect": 5000000000},
        {"$set": "30s", "$expect": 30000000000}
      ]
    }
  },
  "constraints": [
    {
      "when": {"mode": ["global"]},
      "forbid": {"replicas": [1, 2]},
      "reason": "replicas only applies to mode = replicated. Pass 6b run 1 and run 2 (pw-service-03/04/10/13/17/18) applied replicas with mode = global and the provider dropped the value silently. Fixed in Pass 6b Lane Z: docker_service ValidateConfig now rejects the combination ('replicas is not valid for this mode'), mirroring the docker CLI (docker/cli v29.9.3 cli/command/service/opts.go:630), so it is excluded here.",
      "daemon_error": "replicas can only be used with replicated or replicated-job mode"
    }
  ]
}