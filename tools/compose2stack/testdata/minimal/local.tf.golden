# converted from testdata/minimal/compose.yml
# by tools/compose2stack -mode local (project "minimal")

resource "docker_container" "app" {
  name  = "minimal-app-1"
  image = "ghcr.io/example/app:1.0"
  env = {
    LOG_LEVEL = "info"
  }
  labels = {
    "com.docker.compose.container-number" = "1"
    "com.docker.compose.project"          = "minimal"
    "com.docker.compose.service"          = "app"
  }
  restart = "unless-stopped"
  mounts {
    type   = "tmpfs"
    target = "/tmp"
  }
  networks = {
    "traefik_public" = {
      aliases = ["app"]
    }
  }
  ports {
    container_port = 3000
    host_port      = 3000
    host_ip        = "127.0.0.1"
  }
  ports {
    container_port = 9000
    host_port      = 9000
  }
  ports {
    container_port = 9001
    host_port      = 9001
  }
}
